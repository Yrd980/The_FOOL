OPENCLAW_ORCHESTRATOR_URL=http://127.0.0.1:18791
OPENCLAW_ORCHESTRATOR_TOKEN=replace-with-your-token
# Optional: set this when you also need direct gateway calls for probe/move/say.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-with-your-token
# For local operator diagnostics, `openclaw:control` can also fall back to
# `~/.openclaw/openclaw.json -> gateway.auth.token` when explicit env vars are absent.
# Optional: only set this after live gateway hello confirms the method really exists.
# OPENCLAW_COMMAND_METHOD=<verified-live-method>
# OPENCLAW_COMMAND_PARAM_KEY=command
# OPENCLAW_COMMAND_ACTOR_ID=molt-claw
# OPENCLAW_COMMAND_ACTOR_ROLE=host
