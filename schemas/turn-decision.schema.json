{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelwar.local/schemas/turn-decision.schema.json",
  "title": "TurnDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "round",
    "intent",
    "public_message",
    "private_messages",
    "treaty_proposals",
    "actions",
    "emotion_delta",
    "mood_change_reason"
  ],
  "properties": {
    "agent_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
    "round": { "type": "integer", "minimum": 1 },
    "intent": {
      "type": "string",
      "enum": ["expand", "defend", "cooperate", "betray", "art_focus", "revenge"]
    },
    "public_message": { "type": "string", "maxLength": 60 },
    "private_messages": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "content"],
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "content": { "type": "string", "maxLength": 50 }
        }
      }
    },
    "treaty_proposals": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "target_id", "type", "duration_rounds"],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "target_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "type": { "type": "string", "enum": ["no_attack", "joint_attack"] },
          "duration_rounds": { "type": "integer", "minimum": 1, "maximum": 5 },
          "target_enemy_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": { "const": "wait" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "x", "y", "color"],
            "properties": {
              "action": { "const": "paint" },
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "x", "y"],
            "properties": {
              "action": { "const": "fortify" },
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "x", "y"],
            "properties": {
              "action": { "const": "invade" },
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "center_x", "center_y", "radius"],
            "properties": {
              "action": { "const": "burst" },
              "center_x": { "type": "integer", "minimum": 0 },
              "center_y": { "type": "integer", "minimum": 0 },
              "radius": { "const": 1 }
            }
          }
        ]
      }
    },
    "emotion_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anger", "fear", "confidence", "satisfaction"],
      "properties": {
        "anger": { "type": "integer", "minimum": -20, "maximum": 20 },
        "fear": { "type": "integer", "minimum": -20, "maximum": 20 },
        "confidence": { "type": "integer", "minimum": -20, "maximum": 20 },
        "satisfaction": { "type": "integer", "minimum": -20, "maximum": 20 }
      }
    },
    "mood_change_reason": { "type": "string", "maxLength": 60 }
  }
}
