{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelwar.local/schemas/agent-state.schema.json",
  "title": "AgentState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "color",
    "identity_dna",
    "goal_weights",
    "emotion",
    "reputation",
    "energy",
    "cooldowns",
    "relations",
    "memory"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 20 },
    "persona": {
      "type": "string",
      "enum": ["expansionist", "defender", "artist", "schemer"]
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "identity_dna": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "core_values",
        "speech_style",
        "risk_appetite",
        "aggression_bias",
        "diplomacy_bias",
        "creativity_bias",
        "signature_moves",
        "taboos"
      ],
      "properties": {
        "archetype": { "type": "string", "minLength": 1, "maxLength": 40 },
        "core_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 30 }
        },
        "speech_style": { "type": "string", "minLength": 1, "maxLength": 80 },
        "risk_appetite": { "type": "integer", "minimum": 0, "maximum": 100 },
        "aggression_bias": { "type": "integer", "minimum": 0, "maximum": 100 },
        "diplomacy_bias": { "type": "integer", "minimum": 0, "maximum": 100 },
        "creativity_bias": { "type": "integer", "minimum": 0, "maximum": 100 },
        "signature_moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "taboos": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "goal_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["territory", "art", "revenge", "reputation"],
      "properties": {
        "territory": { "type": "number", "minimum": 0, "maximum": 1 },
        "art": { "type": "number", "minimum": 0, "maximum": 1 },
        "revenge": { "type": "number", "minimum": 0, "maximum": 1 },
        "reputation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anger", "fear", "confidence", "satisfaction"],
      "properties": {
        "anger": { "type": "integer", "minimum": 0, "maximum": 100 },
        "fear": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "satisfaction": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "reputation": { "type": "integer", "minimum": 0, "maximum": 100 },
    "energy": { "type": "integer", "minimum": 0, "maximum": 10 },
    "cooldowns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burst"],
      "properties": {
        "burst": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "trust", "affinity", "debt"],
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "trust": { "type": "integer", "minimum": -100, "maximum": 100 },
          "affinity": { "type": "integer", "minimum": -100, "maximum": 100 },
          "debt": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "memory": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "type", "by"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "type": {
            "type": "string",
            "enum": [
              "attacked",
              "betrayed",
              "allied",
              "expanded",
              "lost_area",
              "won_conflict",
              "signed_treaty",
              "broke_treaty"
            ]
          },
          "by": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "target": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "note": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "last_round_summary": { "type": "string", "maxLength": 120 }
  }
}
